# Copie este arquivo para .env e preencha com os seus dados. O .env NAO vai para o Git.

# Conexao com o PostgreSQL 16 (troque SUASENHA pela senha do usuario postgres)
DATABASE_URL="postgresql://postgres:SUASENHA@localhost:5432/zeluvi?schema=public"

# Chave para assinar os tokens JWT (use um texto longo e aleatorio)
JWT_SECRET="troque-por-um-texto-longo-e-aleatorio"
JWT_EXPIRES_IN="8h"

# Porta da API
PORT=3333

# Origens que podem chamar a API (separe por virgula). Ex.: Live Server do VS Code
CORS_ORIGIN="http://localhost:5500,http://127.0.0.1:5500,http://localhost:3333"
