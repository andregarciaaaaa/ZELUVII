# Teste das rotas com a extensao "REST Client" do VS Code (clique em "Send Request").
# Rode antes: npm run db:setup && npm run dev

@api = http://localhost:3334/api/v1

### Saude da API
GET {{api}}/saude

### 1) Login do sindico (guarda o token)
# @name loginSindico
POST {{api}}/auth/login
Content-Type: application/json

{ "email": "sindico@aurora.com", "senha": "Senha@123" }

###
@tokenSindico = {{loginSindico.response.body.token}}

### 2) Login da moradora
# @name loginMorador
POST {{api}}/auth/login
Content-Type: application/json

{ "email": "ana@aurora.com", "senha": "Senha@123" }

###
@tokenMorador = {{loginMorador.response.body.token}}

### Login com senha errada -> 401 NAO_AUTENTICADO
POST {{api}}/auth/login
Content-Type: application/json

{ "email": "sindico@aurora.com", "senha": "errada" }

### Quem sou eu
GET {{api}}/auth/me
Authorization: Bearer {{tokenSindico}}

# ---------------------------------------------------------------- CRUD de avisos

### CREATE - sindico publica -> 201
# @name criado
POST {{api}}/avisos
Authorization: Bearer {{tokenSindico}}
Content-Type: application/json

{
  "titulo": "Limpeza da caixa d'agua",
  "conteudo": "Na terca, das 8h as 12h, a agua ficara suspensa.",
  "expiraEm": "2027-01-31T12:00:00-03:00"
}

###
@idAviso = {{criado.response.body.id}}

### READ - lista (mais novos primeiro, paginada por cursor)
GET {{api}}/avisos?limite=10
Authorization: Bearer {{tokenMorador}}

### READ - um aviso
GET {{api}}/avisos/{{idAviso}}
Authorization: Bearer {{tokenMorador}}

### UPDATE - sindico edita -> 200 com atualizadoEm
PATCH {{api}}/avisos/{{idAviso}}
Authorization: Bearer {{tokenSindico}}
Content-Type: application/json

{ "titulo": "Limpeza da caixa d'agua (novo horario)" }

### DELETE - sindico remove -> 204
DELETE {{api}}/avisos/{{idAviso}}
Authorization: Bearer {{tokenSindico}}

### Depois de removido -> 404 NAO_ENCONTRADO
GET {{api}}/avisos/{{idAviso}}
Authorization: Bearer {{tokenSindico}}

# ---------------------------------------------------------------- erros esperados

### Morador tentando publicar -> 403 SEM_PERMISSAO
POST {{api}}/avisos
Authorization: Bearer {{tokenMorador}}
Content-Type: application/json

{ "titulo": "Teste", "conteudo": "Nao deveria publicar" }

### Sem token -> 401 NAO_AUTENTICADO
GET {{api}}/avisos

### Dados invalidos -> 400 VALIDACAO (titulo curto, campo nao permitido)
POST {{api}}/avisos
Authorization: Bearer {{tokenSindico}}
Content-Type: application/json

{ "titulo": "Oi", "conteudo": "x", "autor": 99 }
